# Tripwire — Oracle Configuration

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Mantle Sepolia (testnet)
MANTLE_RPC_URL=https://rpc.sepolia.mantle.xyz
MANTLE_CHAIN_ID=5003

# Smart Contracts (deploy to Mantle Sepolia first)
GUARD_REGISTRY_ADDRESS=your_deployed_registry_address
GUARD_VAULT_ADDRESS=your_deployed_vault_address
INSURANCE_FUND_ADDRESS=your_deployed_insurance_address

# Oracle Wallet (for submitting scores on-chain)
ORACLE_PRIVATE_KEY=your_oracle_private_key
ORACLE_ADDRESS=your_oracle_wallet_address

# ─── Alpha Intelligence — Data Sources ───

# Nansen API (wallet labels & portfolio) — https://docs.nansen.ai
NANSEN_API_KEY=your_nansen_api_key

# Allora Network (decentralized ML oracle) — https://allora.network
ALLORA_API_KEY=your_allora_api_key

# Elfa AI (social sentiment & market intelligence) — https://docs.elfa.ai
ELFA_API_KEY=your_elfa_api_key

# ─── Telegram Alerts (optional) ───
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERTS_ENABLED=false

# ─── Risk Thresholds ───
RISK_QUARANTINE_THRESHOLD=80
RISK_ALERT_THRESHOLD=60

# ─── Cache TTL ───
SCAN_CACHE_TTL=60
LABEL_CACHE_TTL=300
INFERENCE_CACHE_TTL=120
